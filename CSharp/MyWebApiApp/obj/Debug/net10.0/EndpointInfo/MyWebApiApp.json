              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/subject": {
      "get": {
        "tags": [
          "SubjectMark"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "SubjectMark"
        ],
        "requestBody": {
          "content": {
