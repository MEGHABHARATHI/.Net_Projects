                "$ref": "#/components/schemas/SubjectMark"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SubjectMark"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SubjectMark"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
